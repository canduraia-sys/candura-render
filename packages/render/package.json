{
  "name": "@candura/a2ui-render-shadcn",
  "version": "1.0.0",
  "description": "Renderizador React do catálogo A2UI Candura v1 (Basic do A2UI + componentes de dados), visual shadcn/Tailwind.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "src"],
  "sideEffects": ["*.css"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "clsx": "2.1.1",
    "markdown-it": "14.3.3",
    "recharts": "3.10.1",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
